# Copy to .env and adjust:  cp env.example .env
# .env is gitignored.

# Which data source every command talks to:  yahoo | espn
# yahoo -> drives a real browser (see README "Auth model").
# espn  -> hits ESPN's Fantasy v3 JSON API, no browser.
PROVIDER=yahoo

# --- Yahoo (PROVIDER=yahoo) ------------------------------------------------
# From your team URL: https://football.fantasysports.yahoo.com/f1/891808?mid=14
YAHOO_LEAGUE_ID=891808
YAHOO_TEAM_ID=14

YAHOO_BASE_URL=https://football.fantasysports.yahoo.com

# Run browser headless for roster/lineup commands. `login` is always headed.
HEADLESS=true

# Where the saved login session is stored (relative to project root).
STORAGE_STATE_PATH=.auth/storageState.json

# Optional: pin a specific NFL week (1-18). Blank = provider's current week.
YAHOO_WEEK=

# --- ESPN (PROVIDER=espn) -----------------------------------------------
# League URL: https://fantasy.espn.com/football/team?leagueId=<ID>&teamId=<N>
ESPN_LEAGUE_ID=1144783883
ESPN_TEAM_ID=5
ESPN_SEASON=2026

# Private league: copy these from a browser logged in to fantasy.espn.com
# (DevTools -> Application -> Cookies -> https://fantasy.espn.com).
# SWID keeps its braces, e.g. {1A2B3C4D-....}
ESPN_S2=
ESPN_SWID=

# Optional: pin a specific NFL week for ESPN (falls back to YAHOO_WEEK, then
# ESPN's current scoring period).
ESPN_WEEK=

# Draft prep: abs(rank gap) between the source's expert rank and ADP needed to
# flag a player on the cheat sheet. Lower = more flags.
DRAFT_OVERRIDE_THRESHOLD=18
