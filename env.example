# Copy to .env and adjust:  cp env.example .env
# .env is gitignored.

# Which data source every command talks to:  yahoo | espn | sleeper
# yahoo   -> drives a real browser (see README "Auth model").
# espn    -> hits ESPN's Fantasy v3 JSON API, no browser (needs 2 cookies).
# sleeper -> Sleeper's public read API, no auth at all (draft features only in v1).
PROVIDER=yahoo

# --- Yahoo (PROVIDER=yahoo) ------------------------------------------------
# From your team URL: https://football.fantasysports.yahoo.com/f1/891808?mid=14
YAHOO_LEAGUE_ID=891808
YAHOO_TEAM_ID=14

YAHOO_BASE_URL=https://football.fantasysports.yahoo.com

# Run browser headless for roster/lineup commands. `login` is always headed.
HEADLESS=true

# Where the saved login session is stored (relative to project root).
STORAGE_STATE_PATH=.auth/storageState.json

# Optional: pin a specific NFL week (1-18). Blank = provider's current week.
YAHOO_WEEK=

# --- ESPN (PROVIDER=espn) -----------------------------------------------
# League URL: https://fantasy.espn.com/football/team?leagueId=<ID>&teamId=<N>
ESPN_LEAGUE_ID=1144783883
ESPN_TEAM_ID=5
ESPN_SEASON=2026

# Private league: copy these from a browser logged in to fantasy.espn.com
# (DevTools -> Application -> Cookies -> https://fantasy.espn.com).
# SWID keeps its braces, e.g. {1A2B3C4D-....}
ESPN_S2=
ESPN_SWID=

# Optional: pin a specific NFL week for ESPN (falls back to YAHOO_WEEK, then
# ESPN's current scoring period).
ESPN_WEEK=

# --- Sleeper (PROVIDER=sleeper) -------------------------------------------
# League URL: https://sleeper.com/leagues/<SLEEPER_LEAGUE_ID>
# No token or cookies — reads are fully public. Phase 1: `npm run draft` only
# (roster / waivers / lineup land in later phases).
SLEEPER_LEAGUE_ID=
# Your Sleeper handle (resolved to a user id on first use) so the tool knows
# which team / draft slot is yours. Or set SLEEPER_USER_ID to skip the lookup.
SLEEPER_USERNAME=
SLEEPER_USER_ID=
SLEEPER_SEASON=2026

# Draft prep: abs(rank gap) between the source's expert rank and ADP needed to
# flag a player on the cheat sheet. Lower = more flags.
DRAFT_OVERRIDE_THRESHOLD=18

# --- Player intel (chatter/news) --------------------------------------------
# Sleeper + ESPN news run with no key. The LLM news digest is opt-in:
# set INTEL_LLM=1 (or pass --llm) and provide an Anthropic API key. It costs
# roughly $1 per full `cheatsheet` run on the default model; set
# INTEL_LLM_MODEL=claude-haiku-4-5 to cut that ~15x.
INTEL_LLM=
INTEL_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Parallel digest calls (default 2). Raise once you know your API rate limit
# is comfortable; lower to 1 if you see timeouts / 429s.
INTEL_LLM_CONCURRENCY=
