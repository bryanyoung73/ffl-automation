# Copy to .env and adjust:  cp env.example .env
# .env is gitignored.

# From your team URL: https://football.fantasysports.yahoo.com/f1/891808?mid=14
YAHOO_LEAGUE_ID=891808
YAHOO_TEAM_ID=14

YAHOO_BASE_URL=https://football.fantasysports.yahoo.com

# Run browser headless for roster/lineup commands. `login` is always headed.
HEADLESS=true

# Where the saved login session is stored (relative to project root).
STORAGE_STATE_PATH=.auth/storageState.json

# Optional: pin a specific NFL week (1-18). Leave blank to let Yahoo use the current week.
YAHOO_WEEK=
